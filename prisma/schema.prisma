generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Draw {
  id          String   @id
  dateISO     String
  dateLabel   String
  nums        String
  chance      Int
  source      String   @default("ReducMiz")
  rawDateText String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dateISO])
  @@index([chance])
}

// Generic persisted key/value cache.
// Used for stats caching ("stats:...") and sync rate-limiting ("sync:lastSync"),
// so both survive across serverless cold starts / multiple instances
// (unlike a plain in-memory Map or module-level variable).
model AppCache {
  key       String   @id
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt
}
